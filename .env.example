# Firebase Admin SDK (Firestore) — from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Sign a random 32+ byte string, e.g.: openssl rand -base64 32
SESSION_SECRET=

# Admin panel (/admin) login password
ADMIN_PASSWORD=

# Optional overrides for the general "join GEG" CTAs (defaults are already set in code)
NEXT_PUBLIC_JOIN_FORM_URL=
NEXT_PUBLIC_CONTACT_EMAIL=
